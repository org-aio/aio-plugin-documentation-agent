{
  "name": "application-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.pages.json",
    "test": "node --test src/features/*/*.test.mjs src/config/axios/*.test.mjs",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "crypto-js": "4.2.0",
    "element-plus": "2.14.6",
    "vue": "3.5.12",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.22.0",
    "prettier": "3.2.5",
    "typescript": "5.9.3",
    "unocss": "66.10.5",
    "unplugin-auto-import": "21.1.0",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  }
}
